rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{uid} {

      // Student: hanya bisa membaca dirinya sendiri.
      // Teacher/Admin: bisa membaca semua users untuk dashboard.
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Student hanya boleh membuat profile dirinya sendiri.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
          request.resource.data.role == 'student' ||
          request.resource.data.role == 'casis'
        );

      // Admin: boleh update user mana pun, termasuk role.
      // Student: hanya boleh update dokumennya sendiri dan tidak boleh mengubah role.
      allow update: if request.auth != null
        && (
          // ADMIN
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
          ||
          // STUDENT
          (request.auth.uid == uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && (
              !('role' in request.resource.data) ||
              request.resource.data.role == resource.data.role
            )
          )
        );

      // Admin hanya boleh menghapus pendaftaran CASIS.
      // User dengan role student/teacher/admin tidak boleh dihapus lewat client.
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && resource.data.role == 'casis';
    }

    // ============================================
    // CANDIDATES / CASIS COLLECTION
    // ============================================
    match /candidates/{uid} {

      function isAdmin() {
        return request.auth != null
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      function isCasis() {
        return request.auth != null
          && request.auth.uid == uid
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'casis';
      }

      // CASIS hanya boleh membuat data pendaftarannya sendiri.
      allow create: if isCasis()
        && request.resource.data.uid == uid
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.keys().hasAll([
          'uid',
          'nama',
          'nisn',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().size() >= 6;

      // CASIS hanya boleh membaca data sendiri.
      // Admin boleh membaca seluruh data CASIS.
      allow read: if isCasis() || isAdmin();

      // CASIS hanya boleh mengubah data miliknya.
      // Field status/approval tidak boleh dimanipulasi CASIS.
      // Admin boleh mengubah seluruh data.
      allow update: if isAdmin()
        || (
          isCasis()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'uid',
            'status',
            'createdAt',
            'verifiedAt',
            'acceptedAt',
            'verifiedBy',
            'rejectionReason'
          ])
        );

      allow delete: if false;
    }

    // ============================================
    // ATTENDANCE SESSIONS COLLECTION
    // ============================================
    // CATATAN REDESIGN: sessionId (doc ID) TIDAK LAGI berbasis tanggal.
    // Session BARU (dari handleCreateSession di script.js) selalu formatnya
    // "session_NNN" dan wajib punya field sessionId+status. Session LAMA
    // (attendanceSessions/{tanggal}, dari sebelum redesign) tidak disentuh
    // rules ini sama sekali untuk create/update baru — dokumennya tetap ada
    // apa adanya dan tetap bisa dibaca (allow read di bawah tidak berubah).
    match /attendanceSessions/{sessionId} {

      allow read: if request.auth != null;

      function isAdminOrTeacher() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
        return user.data.role == 'admin' ||
               user.data.role == 'teacher';
      }

      // CREATE: hanya untuk session BARU (docId harus "session_NNN", dibuat oleh
      // flow handleCreateSession). Selalu berstatus ACTIVE saat pertama dibuat —
      // proses archive session lama terjadi lewat operasi UPDATE terpisah
      // (di dokumen session yang lain), dalam Firestore transaction yang sama.
      allow create: if request.auth != null
        && isAdminOrTeacher()
        && request.resource.data.sessionId == sessionId
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.date is string
        && request.resource.data.startTime is timestamp
        && request.resource.data.lateAfter is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.startTime < request.resource.data.lateAfter
        && request.resource.data.lateAfter < request.resource.data.endTime
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasAll(['sessionId', 'date', 'startTime', 'lateAfter', 'endTime', 'status', 'createdAt'])
        && request.resource.data.keys().size() == 7;

      // UPDATE: HANYA transisi ACTIVE -> ARCHIVED (proses archive session lama
      // saat admin membuat session baru). Field lain selain `status` TIDAK BOLEH
      // berubah. Ini juga otomatis menolak upaya "update" pada session LEGACY
      // (doc tanpa field status), karena resource.data.status == 'ACTIVE' pasti
      // gagal untuk dokumen yang field `status`-nya tidak pernah ada.
      allow update: if request.auth != null
        && isAdminOrTeacher()
        && resource.data.status == 'ACTIVE'
        && request.resource.data.status == 'ARCHIVED'
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.date == resource.data.date
        && request.resource.data.startTime == resource.data.startTime
        && request.resource.data.lateAfter == resource.data.lateAfter
        && request.resource.data.endTime == resource.data.endTime
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasAll(['sessionId', 'date', 'startTime', 'lateAfter', 'endTime', 'status', 'createdAt'])
        && request.resource.data.keys().size() == 7;

      allow delete: if false;
    }

    // ============================================
    // SETTINGS COLLECTION (session ID counter)
    // ============================================
    // Dipakai HANYA oleh transaction di handleCreateSession() untuk generate
    // sessionId sequential ("session_001", "session_002", ...) secara aman
    // terhadap race condition, dan menyimpan pointer session ACTIVE saat ini
    // supaya transaction bisa membaca doc ref-nya langsung tanpa query
    // (Firestore transaction tidak mendukung query, hanya get-by-reference).
    // HANYA admin yang boleh read/write — teacher tidak butuh akses ini sama
    // sekali (mereka hanya baca attendanceSessions langsung untuk dropdown).
    match /settings/sessionCounter {

      function isAdmin() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
        return user.data.role == 'admin';
      }

      allow read: if request.auth != null && isAdmin();

      allow create, update: if request.auth != null
        && isAdmin()
        && request.resource.data.lastNumber is int
        && request.resource.data.lastNumber >= 0
        && request.resource.data.activeSessionId is string
        && request.resource.data.keys().hasAll(['lastNumber', 'activeSessionId'])
        && request.resource.data.keys().size() == 2;

      allow delete: if false;
    }

    // ============================================
    // ATTENDANCE COLLECTION
    // ============================================
    match /attendance/{docId} {

      function isValidSessionTime() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return session != null
          && request.time >= session.startTime
          && request.time <= session.endTime;
      }

      function getCorrectStatus() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return request.time <= session.lateAfter
          ? 'HADIR'
          : 'TERLAMBAT';
      }

      // ===== SESSION REDESIGN HELPERS =====
      // sessionId sekarang identity independen dari tanggal, jadi validasi lama
      // `tanggal == sessionId` diganti dengan memastikan `tanggal` yang dikirim
      // client benar-benar cocok dengan field `date` pada dokumen session yang
      // dirujuk (bukan sekadar sama dengan sessionId itu sendiri).
      function sessionDateMatches() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return session != null && session.date == request.resource.data.tanggal;
      }

      // Session ARCHIVED (termasuk session LEGACY yang tidak punya field `status`
      // sama sekali) tidak boleh dipakai untuk create attendance baru oleh STUDENT
      // atau TEACHER. Admin dikecualikan (lihat blok ADMIN MANUAL di bawah) karena
      // butuh koreksi/menambah data historis ke session yang sudah diarsipkan.
      function isSessionActive() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return session != null && session.status == 'ACTIVE';
      }

      function getCurrentUserClassId() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        return user.classId;
      }

      function getCurrentUserRole() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        return user.role;
      }

      // ===== TEACHER MANUAL ATTENDANCE HELPERS =====
      function isValidManualStatus(status) {
        return status == 'IZIN' || status == 'SAKIT' || status == 'ALFA';
      }

      // SOURCE OF TRUTH: validasi target dari Firestore
      // Memastikan:
      // 1. Target user exists
      // 2. Target role == student
      // 3. Target classId == clientClassId (classId dari database, bukan dari client)
      function isValidTeacherManualTarget(targetUid, clientClassId) {
        let targetUser = get(
          /databases/$(database)/documents/users/$(targetUid)
        ).data;
        return targetUser != null
          && targetUser.role == 'student'
          && targetUser.classId == clientClassId;
      }

      // ===== ADMIN MANUAL ATTENDANCE HELPERS =====
      function isValidFullStatus(status) {
        return status == 'HADIR' || status == 'TERLAMBAT'
          || status == 'IZIN' || status == 'SAKIT' || status == 'ALFA';
      }

      // SOURCE OF TRUTH: validasi target dari Firestore (admin tidak dibatasi classId sendiri)
      // Memastikan:
      // 1. Target user exists
      // 2. Target role == student
      // 3. Target classId == clientClassId (classId dari database, bukan dari client)
      function isValidAdminManualTarget(targetUid, clientClassId) {
        let targetUser = get(
          /databases/$(database)/documents/users/$(targetUid)
        ).data;
        return targetUser != null
          && targetUser.role == 'student'
          && targetUser.classId == clientClassId;
      }

      // ===== SHARED UPDATE HELPER =====
      // Dipakai saat UPDATE (resource.data sudah ada): memastikan uid target
      // pada dokumen attendance existing memang milik user dengan role student.
      function isTargetStudentRole(targetUid) {
        let targetUser = get(
          /databases/$(database)/documents/users/$(targetUid)
        ).data;
        return targetUser != null && targetUser.role == 'student';
      }

      // Variant untuk UPDATE (korekasi): sessionId diambil dari resource.data
      // (dokumen existing), bukan request.resource.data, karena update TIDAK
      // BOLEH mengubah sessionId (sudah dikunci terpisah di bawah).
      function isSessionActiveForCorrection() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(resource.data.sessionId)
        ).data;

        return session != null && session.status == 'ACTIVE';
      }

      // Student: hanya attendance miliknya.
      // Teacher/Admin: bisa membaca seluruh attendance untuk dashboard.
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        getCurrentUserRole() == 'teacher' ||
        getCurrentUserRole() == 'admin'
      );

      // Student hanya boleh membuat attendance untuk dirinya sendiri.
      // Teacher manual attendance HANYA untuk student di classId-nya sendiri.
      // Admin manual attendance untuk student di kelas mana pun.
      allow create: if request.auth != null
        && (
          // ===== STUDENT QR =====
          (getCurrentUserRole() == 'student'
            && request.auth.uid == request.resource.data.uid
            && docId.matches('^' + request.auth.uid + '_.*')
            && !exists(/databases/$(database)/documents/attendance/$(docId))
            && isValidSessionTime()
            && isSessionActive()
            && request.resource.data.status == getCorrectStatus()
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
            && request.resource.data.uid is string
            && request.resource.data.tanggal is string
            && request.resource.data.status is string
            && request.resource.data.classId is string
            && request.resource.data.method is string
            && request.resource.data.sessionId is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.classId == getCurrentUserClassId()
            && sessionDateMatches()
            && request.resource.data.method == 'qr'
          )
          ||
          // ===== TEACHER MANUAL =====
          (getCurrentUserRole() == 'teacher'
            && isValidManualStatus(request.resource.data.status)
            && request.resource.data.uid != request.auth.uid
            // SOURCE OF TRUTH: validasi target dari database
            && isValidTeacherManualTarget(
                 request.resource.data.uid,
                 request.resource.data.classId
               )
            // Teacher hanya boleh menyentuh student di classId-nya sendiri
            && getCurrentUserClassId() == request.resource.data.classId
            // Teacher HANYA boleh manual attendance pada session yang ACTIVE
            // (Admin dikecualikan — lihat blok ADMIN MANUAL di bawah).
            && isSessionActive()
            && sessionDateMatches()
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
            && request.resource.data.uid is string
            && request.resource.data.tanggal is string
            && request.resource.data.status is string
            && request.resource.data.classId is string
            && request.resource.data.method is string
            && request.resource.data.sessionId is string
            && request.resource.data.createdAt is timestamp
            && !exists(/databases/$(database)/documents/attendance/$(docId))
            && request.resource.data.method == 'manual'
          )
          ||
          // ===== ADMIN MANUAL =====
          (getCurrentUserRole() == 'admin'
            && isValidFullStatus(request.resource.data.status)
            && request.resource.data.uid != request.auth.uid
            // SOURCE OF TRUTH: validasi target dari database (tanpa batasan classId admin)
            && isValidAdminManualTarget(
                 request.resource.data.uid,
                 request.resource.data.classId
               )
            // Admin BOLEH manual attendance pada session ACTIVE maupun ARCHIVED
            // (dibutuhkan untuk koreksi/history) — sessionDateMatches() sudah
            // cukup memastikan sessionId merujuk session yang benar-benar ada.
            && sessionDateMatches()
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
            && request.resource.data.uid is string
            && request.resource.data.tanggal is string
            && request.resource.data.status is string
            && request.resource.data.classId is string
            && request.resource.data.method is string
            && request.resource.data.sessionId is string
            && request.resource.data.createdAt is timestamp
            && !exists(/databases/$(database)/documents/attendance/$(docId))
            && request.resource.data.method == 'manual'
          )
        );

      // ===== UPDATE (KOREKSI ATTENDANCE EXISTING) =====
      // Student: TIDAK PERNAH boleh update (tidak ada cabang untuk role student).
      // Teacher: boleh koreksi status HANYA untuk student di kelasnya sendiri,
      //          HANYA menjadi IZIN/SAKIT/ALFA (tidak pernah HADIR/TERLAMBAT),
      //          dan tidak boleh mengubah field identitas dokumen.
      // Admin: boleh koreksi status ke salah satu dari 5 status, untuk student
      //        di kelas mana pun, dan tidak boleh mengubah field identitas dokumen.
      allow update: if request.auth != null
        && (
          // ===== ADMIN CORRECTION =====
          (getCurrentUserRole() == 'admin'
            && isTargetStudentRole(resource.data.uid)
            && isValidFullStatus(request.resource.data.status)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.tanggal == resource.data.tanggal
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.sessionId == resource.data.sessionId
            && request.resource.data.method == resource.data.method
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
          )
          ||
          // ===== TEACHER CORRECTION (kelas sendiri, status terbatas) =====
          (getCurrentUserRole() == 'teacher'
            && isTargetStudentRole(resource.data.uid)
            && getCurrentUserClassId() == resource.data.classId
            && isValidManualStatus(request.resource.data.status)
            // Konsisten dengan pembatasan CREATE: teacher hanya boleh menyentuh
            // (termasuk koreksi) attendance pada session yang masih ACTIVE.
            && isSessionActiveForCorrection()
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.tanggal == resource.data.tanggal
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.sessionId == resource.data.sessionId
            && request.resource.data.method == resource.data.method
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
          )
        );

      allow delete: if false;
    }
  }
}