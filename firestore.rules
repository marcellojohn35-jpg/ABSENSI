rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{uid} {

      // Student: hanya bisa membaca dirinya sendiri.
      // Teacher/Admin: bisa membaca semua users untuk dashboard.
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Student hanya boleh membuat profile dirinya sendiri.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'student';

      // Admin: boleh update user mana pun, termasuk role.
      // Student: hanya boleh update dokumennya sendiri dan tidak boleh mengubah role.
      allow update: if request.auth != null
        && (
          // ADMIN
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
          ||
          // STUDENT
          (request.auth.uid == uid
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
            && (
              !('role' in request.resource.data) ||
              request.resource.data.role == resource.data.role
            )
          )
        );

      allow delete: if false;
    }

    // ============================================
    // ATTENDANCE SESSIONS COLLECTION
    // ============================================
    match /attendanceSessions/{sessionId} {

      allow read: if request.auth != null;

      function isAdminOrTeacher() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
        return user.data.role == 'admin' ||
               user.data.role == 'teacher';
      }

      allow create, update: if request.auth != null
        && isAdminOrTeacher()
        && request.resource.data.startTime is timestamp
        && request.resource.data.lateAfter is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.startTime < request.resource.data.lateAfter
        && request.resource.data.lateAfter < request.resource.data.endTime;

      allow delete: if false;
    }

    // ============================================
    // ATTENDANCE COLLECTION
    // ============================================
    match /attendance/{docId} {

      function isValidSessionTime() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return session != null
          && request.time >= session.startTime
          && request.time <= session.endTime;
      }

      function getCorrectStatus() {
        let session = get(
          /databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)
        ).data;

        return request.time <= session.lateAfter
          ? 'HADIR'
          : 'TERLAMBAT';
      }

      function getCurrentUserClassId() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        return user.classId;
      }

      function getCurrentUserRole() {
        let user = get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data;
        return user.role;
      }

      // ===== TEACHER MANUAL ATTENDANCE HELPERS =====
      function isValidManualStatus(status) {
        return status == 'IZIN' || status == 'SAKIT' || status == 'ALFA';
      }

      // SOURCE OF TRUTH: validasi target dari Firestore
      // Memastikan:
      // 1. Target user exists
      // 2. Target role == student
      // 3. Target classId == clientClassId (classId dari database, bukan dari client)
      function isValidTeacherManualTarget(targetUid, clientClassId) {
        let targetUser = get(
          /databases/$(database)/documents/users/$(targetUid)
        ).data;
        return targetUser != null
          && targetUser.role == 'student'
          && targetUser.classId == clientClassId;
      }

      // Student: hanya attendance miliknya.
      // Teacher/Admin: bisa membaca seluruh attendance untuk dashboard.
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        getCurrentUserRole() == 'teacher' ||
        getCurrentUserRole() == 'admin'
      );

      // Student hanya boleh membuat attendance untuk dirinya sendiri.
      // Teacher manual attendance untuk semua student (tanpa batasan classId teacher).
      allow create: if request.auth != null
        && (
          // ===== STUDENT QR =====
          (getCurrentUserRole() == 'student'
            && request.auth.uid == request.resource.data.uid
            && docId.matches('^' + request.auth.uid + '_.*')
            && !exists(/databases/$(database)/documents/attendance/$(docId))
            && isValidSessionTime()
            && request.resource.data.status == getCorrectStatus()
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
            && request.resource.data.uid is string
            && request.resource.data.tanggal is string
            && request.resource.data.status is string
            && request.resource.data.classId is string
            && request.resource.data.method is string
            && request.resource.data.sessionId is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.classId == getCurrentUserClassId()
            && request.resource.data.tanggal == request.resource.data.sessionId
            && request.resource.data.method == 'qr'
          )
          ||
          // ===== TEACHER MANUAL =====
          (getCurrentUserRole() == 'teacher'
            && isValidManualStatus(request.resource.data.status)
            && request.resource.data.uid != request.auth.uid
            // SOURCE OF TRUTH: validasi target dari database
            && isValidTeacherManualTarget(
                 request.resource.data.uid,
                 request.resource.data.classId
               )
            && request.resource.data.tanggal == request.resource.data.sessionId
            && request.resource.data.keys().hasAll([
              'uid',
              'tanggal',
              'status',
              'classId',
              'method',
              'sessionId',
              'createdAt'
            ])
            && request.resource.data.keys().size() == 7
            && request.resource.data.uid is string
            && request.resource.data.tanggal is string
            && request.resource.data.status is string
            && request.resource.data.classId is string
            && request.resource.data.method is string
            && request.resource.data.sessionId is string
            && request.resource.data.createdAt is timestamp
            && !exists(/databases/$(database)/documents/attendance/$(docId))
            && request.resource.data.method == 'manual'
          )
        );

      allow update, delete: if false;
    }
  }
}